{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Pixelogic OS design tokens — synced from globals.css and page.tsx. Update CSS variables in globals.css as the source of truth; update chapter accents in page.tsx/section-wrapper.tsx.",

  "color": {
    "light": {
      "background":            { "$type": "color", "$value": "oklch(1 0 0)",           "$description": "Page background" },
      "foreground":            { "$type": "color", "$value": "oklch(0.145 0 0)",        "$description": "Default text" },
      "card":                  { "$type": "color", "$value": "oklch(1 0 0)",            "$description": "Card background" },
      "card-foreground":       { "$type": "color", "$value": "oklch(0.145 0 0)",        "$description": "Card text" },
      "popover":               { "$type": "color", "$value": "oklch(1 0 0)",            "$description": "Popover background" },
      "popover-foreground":    { "$type": "color", "$value": "oklch(0.145 0 0)",        "$description": "Popover text" },
      "primary":               { "$type": "color", "$value": "oklch(0.205 0 0)",        "$description": "Primary action — dark gray" },
      "primary-foreground":    { "$type": "color", "$value": "oklch(0.985 0 0)",        "$description": "Text on primary" },
      "secondary":             { "$type": "color", "$value": "oklch(0.97 0 0)",         "$description": "Secondary surface" },
      "secondary-foreground":  { "$type": "color", "$value": "oklch(0.205 0 0)",        "$description": "Text on secondary" },
      "muted":                 { "$type": "color", "$value": "oklch(0.97 0 0)",         "$description": "Muted surface" },
      "muted-foreground":      { "$type": "color", "$value": "oklch(0.556 0 0)",        "$description": "Muted text — used for labels and captions" },
      "accent":                { "$type": "color", "$value": "oklch(0.97 0 0)",         "$description": "Accent hover surface" },
      "accent-foreground":     { "$type": "color", "$value": "oklch(0.205 0 0)",        "$description": "Text on accent" },
      "destructive":           { "$type": "color", "$value": "oklch(0.577 0.245 27.325)", "$description": "Danger / error" },
      "border":                { "$type": "color", "$value": "oklch(0.922 0 0)",        "$description": "Default border" },
      "input":                 { "$type": "color", "$value": "oklch(0.922 0 0)",        "$description": "Input border" },
      "ring":                  { "$type": "color", "$value": "oklch(0.708 0 0)",        "$description": "Focus ring" }
    },

    "dark": {
      "background":            { "$type": "color", "$value": "oklch(0.145 0 0)",        "$description": "Dark page background" },
      "foreground":            { "$type": "color", "$value": "oklch(0.985 0 0)",        "$description": "Dark default text" },
      "card":                  { "$type": "color", "$value": "oklch(0.145 0 0)" },
      "card-foreground":       { "$type": "color", "$value": "oklch(0.985 0 0)" },
      "primary":               { "$type": "color", "$value": "oklch(0.985 0 0)" },
      "primary-foreground":    { "$type": "color", "$value": "oklch(0.205 0 0)" },
      "secondary":             { "$type": "color", "$value": "oklch(0.269 0 0)" },
      "secondary-foreground":  { "$type": "color", "$value": "oklch(0.985 0 0)" },
      "muted":                 { "$type": "color", "$value": "oklch(0.269 0 0)" },
      "muted-foreground":      { "$type": "color", "$value": "oklch(0.708 0 0)" },
      "accent":                { "$type": "color", "$value": "oklch(0.269 0 0)" },
      "accent-foreground":     { "$type": "color", "$value": "oklch(0.985 0 0)" },
      "destructive":           { "$type": "color", "$value": "oklch(0.396 0.141 25.723)" },
      "border":                { "$type": "color", "$value": "oklch(0.269 0 0)" },
      "input":                 { "$type": "color", "$value": "oklch(0.269 0 0)" },
      "ring":                  { "$type": "color", "$value": "oklch(0.439 0 0)" }
    },

    "chart": {
      "1": { "$type": "color", "$value": "oklch(0.646 0.222 41.116)",  "$description": "Warm orange" },
      "2": { "$type": "color", "$value": "oklch(0.6 0.118 184.704)",   "$description": "Teal" },
      "3": { "$type": "color", "$value": "oklch(0.398 0.07 227.392)",  "$description": "Navy" },
      "4": { "$type": "color", "$value": "oklch(0.828 0.189 84.429)",  "$description": "Yellow" },
      "5": { "$type": "color", "$value": "oklch(0.769 0.188 70.08)",   "$description": "Amber" }
    },

    "chapter": {
      "$description": "Per-chapter accent colors used for gradient overlays and section spotlights. Index matches CHAPTERS order in lib/chapters-config.ts.",
      "0-prologue":   { "$type": "color", "$value": "rgb(34, 211, 238)",   "$description": "Cyan — Hero/Prologue" },
      "1-origin":     { "$type": "color", "$value": "rgb(6, 182, 212)",    "$description": "Dark cyan — About/Origin" },
      "2-shift":      { "$type": "color", "$value": "rgb(124, 58, 237)",   "$description": "Violet — Capabilities/Shift" },
      "3-method":     { "$type": "color", "$value": "rgb(167, 139, 250)",  "$description": "Lavender — Process/Method" },
      "4-work":       { "$type": "color", "$value": "rgb(56, 189, 248)",   "$description": "Sky blue — Work" },
      "5-notes":      { "$type": "color", "$value": "rgb(147, 197, 253)",  "$description": "Powder blue — Notes" },
      "6-epilogue":   { "$type": "color", "$value": "rgb(224, 249, 255)",  "$description": "Ice — Contact/Epilogue" }
    },

    "window": {
      "surface":      { "$type": "color", "$value": "rgba(2, 6, 23, 0.87)",  "$description": "WindowShell background — slate-950 87% opacity" },
      "titlebar":     { "$type": "color", "$value": "rgba(15, 23, 42, 0.70)", "$description": "WindowShell title bar — slate-900 70% opacity" },
      "border":       { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)", "$description": "WindowShell border" }
    },

    "traffic-light": {
      "red":    { "$type": "color", "$value": "#FF5F57", "$description": "macOS close button" },
      "yellow": { "$type": "color", "$value": "#FEBC2E", "$description": "macOS minimise button" },
      "green":  { "$type": "color", "$value": "#28C840", "$description": "macOS fullscreen button" }
    }
  },

  "typography": {
    "font-sans":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"],              "$description": "Body text" },
    "font-mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"],                   "$description": "Code, labels, metadata" },
    "font-display": { "$type": "fontFamily", "$value": ["Press Start 2P", "monospace"],                   "$description": "Pixel-art display font — logo, hero headline" },

    "scale": {
      "xs":   { "$type": "dimension", "$value": "0.75rem",  "$description": "12px — captions, meta labels" },
      "sm":   { "$type": "dimension", "$value": "0.875rem", "$description": "14px — body small, card content" },
      "base": { "$type": "dimension", "$value": "1rem",     "$description": "16px — default body" },
      "lg":   { "$type": "dimension", "$value": "1.125rem", "$description": "18px" },
      "xl":   { "$type": "dimension", "$value": "1.25rem",  "$description": "20px" },
      "2xl":  { "$type": "dimension", "$value": "1.5rem",   "$description": "24px — section headings" },
      "3xl":  { "$type": "dimension", "$value": "1.875rem", "$description": "30px — page headings" }
    },

    "tracking": {
      "label":   { "$type": "string", "$value": "0.18em", "$description": "Uppercase mono labels (font-mono uppercase)" },
      "meta":    { "$type": "string", "$value": "0.05em", "$description": "Meta rows, badge text" }
    }
  },

  "spacing": {
    "section-x-mobile":  { "$type": "dimension", "$value": "1.5rem",  "$description": "Horizontal padding on mobile (px-6)" },
    "section-x-desktop": { "$type": "dimension", "$value": "2rem",    "$description": "Horizontal padding on desktop (px-8)" },
    "section-y":         { "$type": "dimension", "$value": "3rem",    "$description": "Vertical padding for section pages (py-12)" },
    "content-max-width": { "$type": "dimension", "$value": "56rem",   "$description": "max-w-4xl — case study content width" }
  },

  "radius": {
    "sm":  { "$type": "dimension", "$value": "0.25rem",  "$description": "calc(--radius - 4px)" },
    "md":  { "$type": "dimension", "$value": "0.375rem", "$description": "calc(--radius - 2px)" },
    "lg":  { "$type": "dimension", "$value": "0.625rem", "$description": "--radius base" },
    "xl":  { "$type": "dimension", "$value": "0.875rem", "$description": "calc(--radius + 4px)" },
    "2xl": { "$type": "dimension", "$value": "0.75rem",  "$description": "rounded-xl on cards" },
    "full":{ "$type": "dimension", "$value": "9999px",   "$description": "Pills, status dots" }
  },

  "shadow": {
    "window":      { "$type": "shadow", "$value": "0 8px 40px rgba(0,0,0,0.65)",  "$description": "WindowShell default shadow" },
    "window-hover":{ "$type": "shadow", "$value": "0 12px 48px rgba(0,0,0,0.70)", "$description": "WindowShell hover shadow" }
  }
}
