# ── Visitor counter + click stats (optional) ───────────────────────────────
# Created automatically when you connect an Upstash Redis database to the
# project in Vercel (Storage → Create Database → Upstash for Redis).
# Either naming works; leave both unset and the counter simply stays hidden.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Secret for the private dashboard: /stats?key=<STATS_KEY>
STATS_KEY=

# Optional: canonical site URL for share cards
# NEXT_PUBLIC_SITE_URL=https://vishal-deshmukh.vercel.app
